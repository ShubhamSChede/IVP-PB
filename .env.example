# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key   # server only

# Edit mode
EDIT_CODE=change-me                 # the single code organisers type to unlock edit mode
SESSION_SECRET=long-random-string   # signs the edit cookie: `openssl rand -hex 32`
